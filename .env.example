# Sao chép thành .env và điền giá trị thật. KHÔNG commit .env.
# PROVIDER: openai | openrouter
PROVIDER=openai
# openai -> gpt-4o-mini ; openrouter -> openai/gpt-4o-mini
MODEL=gpt-4o-mini
OPENAI_API_KEY=YOUR_KEY
# Tùy chọn: ghi đè endpoint
# OPENAI_BASE_URL=

# --- Day 6: PostgreSQL + pgvector (Docker, local) ---
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DAY6_STRATEGY=B
